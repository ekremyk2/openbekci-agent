{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.openbekci.org/agent-protocol/v1/event.schema.json",
  "description": "detail is limited to 2 KB, which the agent checks (JSON Schema has no byte-size keyword).",
  "type": "object",
  "required": ["events"],
  "properties": {
    "clock_offset_ms": { "type": ["integer", "null"] },
    "events": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": ["id", "point_id", "decision", "reason", "occurred_at"],
        "properties": {
          "id": { "$ref": "defs.json#/$defs/uuidv7" },
          "point_id": { "$ref": "defs.json#/$defs/uuid" },
          "decision": { "enum": ["allow", "deny", "manual_open"] },
          "reason": { "type": "string" },
          "occurred_at": { "$ref": "defs.json#/$defs/ts" },
          "credential_id": { "$ref": "defs.json#/$defs/uuid" },
          "presented_kind": { "type": "string" },
          "observed_plate": { "type": "string" },
          "command_id": { "$ref": "defs.json#/$defs/uuid" },
          "visitor_entry_id": { "$ref": "defs.json#/$defs/uuid" },
          "raw_ref": { "type": "string", "maxLength": 256 },
          "detail": { "type": "object" }
        }
      }
    }
  },
  "additionalProperties": true
}
